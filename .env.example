# 此文件仅列可选配置；不要提交真实密钥。
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DATABASE_URL=mysql://researchloop:researchloop_local@127.0.0.1:33316/researchloop
RESEARCHLOOP_DATA_DIR=
RESEARCHLOOP_OUTPUT_DIR=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_BM25_RPC=match_arxiv_papers_bm25
# 默认读取 data/config/dpr-sources.json，由 import_dpr_sources.py 从上游公开配置复制。
# 各来源使用独立 RPC；没有配置则明确 not_configured，不静默换源。
RESEARCHLOOP_DPR_CONFIG=
SUPABASE_SCHEMA=public
# Worker读取配置；导入API不调用模型。

# AG7.2本机原文检索；仅按当前任务已授权页建库，无启动时批量导入。
RESEARCHLOOP_RETRIEVAL_ENABLED=1
# 留空时使用项目data/ag71-preflight/models/manifest.json中的固定文件。
RESEARCHLOOP_RETRIEVAL_MODEL_MANIFEST=
RESEARCHLOOP_RETRIEVAL_NAMESPACE=researchloop_evidence_v1
RESEARCHLOOP_QDRANT_URL=http://127.0.0.1:6339

# 新根任务及全部子 Agent 共享累计 Token 准入上限；旧任务不回填。
RESEARCHLOOP_TASK_TOKEN_LIMIT=1000000
# 仅 Supervisor 可用的收尾余量；不是额外增加的 Token。
RESEARCHLOOP_TASK_TOKEN_TAIL=32768
