# 最小配置：填写自己的密钥；模型名使用本机已验证的公开型号。
# 不要把真实 .env 提交到 Git。下方可选项不取消注释就使用程序默认值。
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

# 模型接口（兼容 Chat Completions）
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# 数据库与本机目录；目录留空时也使用默认值，不会写入当前工作目录。
# DATABASE_URL=mysql://researchloop:researchloop_local@127.0.0.1:33316/researchloop
# RESEARCHLOOP_DATA_DIR=data/ag1
# RESEARCHLOOP_OUTPUT_DIR=data/ag1/notes
# 自定义 Docker 密码时，同时更新上面的 DATABASE_URL；默认仅绑定本机。
# RESEARCHLOOP_MYSQL_ROOT_PASSWORD=researchloop_root_local
# RESEARCHLOOP_MYSQL_PASSWORD=researchloop_local

# 论文源：复制 config/paper-sources.example.json 到本机并配置合法只读连接。
# RESEARCHLOOP_PAPER_SOURCES_CONFIG=data/config/paper-sources.json
# 以下选项可覆盖 JSON 中的共享连接；逐源 RPC 仍由来源配置决定。
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SCHEMA=public
# SUPABASE_BM25_RPC=match_arxiv_papers_bm25

# 本机证据检索：需另配权重及 config/model-manifest.example.json 对应的清单。
# RESEARCHLOOP_RETRIEVAL_ENABLED=1
# Apple Silicon默认采用片段定位与MPS FP16，模型缺失/不可用时显式降级。
# RESEARCHLOOP_RETRIEVAL_ROUTE=located_fp16
# RESEARCHLOOP_RERANKER_BACKEND=mps_fp16
# PYTORCH_ENABLE_MPS_FALLBACK=0
# 可显式设hybrid_rrf / onnx_cpu恢复旧检索路线与CPU重排。
# RESEARCHLOOP_RETRIEVAL_MODEL_MANIFEST=
# RESEARCHLOOP_RETRIEVAL_NAMESPACE=researchloop_evidence_v1
# RESEARCHLOOP_QDRANT_URL=http://127.0.0.1:6339

# 执行策略：只冻结到新任务；不会改变旧任务、成功收据或unknown状态。
# enforce执行已有额度；observe仅监测请求数/工具数/累计Token，保留取消/权限/无进展结束。
# Reflection轮次是独立设置；本轮未修改其原有默认值。
# RESEARCHLOOP_EXECUTION_BUDGET_MODE=enforce
# RESEARCHLOOP_MAX_MODEL_REQUESTS=48
# RESEARCHLOOP_MAX_TOOL_ACTIONS=80
# RESEARCHLOOP_RESERVE_MODEL_REQUESTS=10
# RESEARCHLOOP_TASK_TOKEN_LIMIT=1000000
# RESEARCHLOOP_TASK_TOKEN_TAIL=32768
# RESEARCHLOOP_REFLECTION_ROUNDS=2
# 并发槽位与一次规划的子任务数分开；初始2槽兼容已有资源使用。
# RESEARCHLOOP_RESEARCHER_CONCURRENCY=2

# 单请求上下文：0按模型能力选择。显式旧128000仍生效，不自动扩容。
# Flash官方规格为1M上下文/最大384K输出；实际输出预留独立配置。
# RESEARCHLOOP_CONTEXT_WINDOW=0
# RESEARCHLOOP_CONTEXT_OUTPUT_RESERVE=8192
# RESEARCHLOOP_CONTEXT_SAFETY_TOKENS=4096
# RESEARCHLOOP_HISTORY_TOKENS=12000
# 可选本地tokenizer.json：显式声明兼容模型，文件hash自动冻结；可填SHA256校验下载内容。
# 不自动下载，也不将未经验证的旧版tokenizer冒充当前模型的精确计数器。
# 离线文本计数仍不等于供应商包含内部格式开销的账单，实际usage为准。
# RESEARCHLOOP_TOKENIZER_PATH=
# RESEARCHLOOP_TOKENIZER_MODEL=
# RESEARCHLOOP_TOKENIZER_SHA256=

# 可选DeepSeek Search/Fetch：另按请求计费，默认关闭；沿用上方key/base URL。
# 由Supervisor选择合法备用来源，不保证能访问验证页或受限全文。
# RESEARCHLOOP_WEB_SEARCH_ENABLED=0
# RESEARCHLOOP_WEB_FETCH_ENABLED=0
# RESEARCHLOOP_WEB_TOOLS_TIMEOUT_SECONDS=30
# 单响应传输保护，单位为字节；不是论文数量或任务额度。
# RESEARCHLOOP_WEB_TOOLS_MAX_RESPONSE_BYTES=2097152

# 可选图表裁剪；未配置时回退到本地 PDF 内嵌图片提取。
# PAPERCROPPER_SCRIPT=
# PAPERCROPPER_MODEL=
# PAPERCROPPER_PYTHON=
# PAPERCROPPER_DISABLE=1
# PAPERCROPPER_TIMEOUT_SECONDS=360
