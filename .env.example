# 最小配置：填写自己的密钥；模型名使用本机已验证的公开型号。
# 不要把真实 .env 提交到 Git。下方可选项不取消注释就使用程序默认值。
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

# 模型接口（兼容 Chat Completions）
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# 数据库与本机目录；目录留空时也使用默认值，不会写入当前工作目录。
# DATABASE_URL=mysql://researchloop:researchloop_local@127.0.0.1:33316/researchloop
# RESEARCHLOOP_DATA_DIR=data/ag1
# RESEARCHLOOP_OUTPUT_DIR=data/ag1/notes
# 自定义 Docker 密码时，同时更新上面的 DATABASE_URL；默认仅绑定本机。
# RESEARCHLOOP_MYSQL_ROOT_PASSWORD=researchloop_root_local
# RESEARCHLOOP_MYSQL_PASSWORD=researchloop_local

# 论文源：复制 config/paper-sources.example.json 到本机并配置合法只读连接。
# RESEARCHLOOP_PAPER_SOURCES_CONFIG=data/config/paper-sources.json
# 以下选项可覆盖 JSON 中的共享连接；逐源 RPC 仍由来源配置决定。
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SCHEMA=public
# SUPABASE_BM25_RPC=match_arxiv_papers_bm25

# 本机证据检索：需另配权重及 config/model-manifest.example.json 对应的清单。
# RESEARCHLOOP_RETRIEVAL_ENABLED=1
# RESEARCHLOOP_RETRIEVAL_MODEL_MANIFEST=
# RESEARCHLOOP_RETRIEVAL_NAMESPACE=researchloop_evidence_v1
# RESEARCHLOOP_QDRANT_URL=http://127.0.0.1:6339

# 原有任务与上下文默认值；不是本次新增限制，旧任务不回填。
# RESEARCHLOOP_TASK_TOKEN_LIMIT=1000000
# RESEARCHLOOP_TASK_TOKEN_TAIL=32768
# RESEARCHLOOP_REFLECTION_ROUNDS=2
# RESEARCHLOOP_CONTEXT_WINDOW=128000
# RESEARCHLOOP_HISTORY_TOKENS=12000

# 可选图表裁剪；未配置时回退到本地 PDF 内嵌图片提取。
# PAPERCROPPER_SCRIPT=
# PAPERCROPPER_MODEL=
# PAPERCROPPER_PYTHON=
# PAPERCROPPER_DISABLE=1
# PAPERCROPPER_TIMEOUT_SECONDS=360
